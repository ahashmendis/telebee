# Optional public server port
PORT=3001

# ngrok authentication token
# Get this from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional reserved domain. Free ngrok accounts should leave this blank.
TELEBEE_NGROK_URL=

# Optional TURN relay so video calls work on strict networks (corporate Wi-Fi,
# some mobile carriers). Free tiers: Cloudflare Realtime TURN, Metered.
# TURN_URLS accepts a comma-separated list.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Maximum people per room (default 2)
TELEBEE_MAX_PEERS=2
